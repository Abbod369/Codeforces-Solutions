#include <iostream>
using namespace std;

int main()
{
    int t , n;
    int arr[5001];
    int ind1 , ind2;
    int num1 , num2;
    bool ok;
    cin >> t;
    while(t--)
    {
        ok = true;
        cin >> n >> arr[1];
        num1 = arr[1];
        ind1 = 1;
        for(int i = 2; i <= n; i++)
        {
            cin >> arr[i];
            if(arr[i] != num1 && ok)
            {
                num2 = arr[i];
                ind2 = i;
                ok = false;
            }
        }

        if(ok)
        {
            cout << "NO" << endl;
            continue;
        }

        cout << "YES" << endl;

        for(int i = 1; i <= n; i++)
        {
            if(arr[i] != num1 && i != ind2)
            cout << i << ' ' << ind1 << endl;

            else if(arr[i] != num2)
            cout << i << ' ' << ind2 << endl;
        }

    }
    
    return 0;
}
