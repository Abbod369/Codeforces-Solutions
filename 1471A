#include <iostream>
using namespace std;

int main()
{
    int t;
    int n , x;
    int arr[100001];
    long long sum1;
    long long sum2;
    cin >> t;
    while(t--)
    {
        sum1 = 0;
        sum2 = 0;
        cin >> n >> x;
        for(int i = 0; i < n; i++)
        {
            cin >> arr[i];
            sum1 += arr[i];
        }

        sum1 = (sum1 + (x - 1)) / x;

        for(int i = 0; i < n; i++)
        sum2 += (arr[i]  + (x - 1)) / x;

        cout << sum1 << ' ' << sum2 << endl;

    }

    return 0;
}
