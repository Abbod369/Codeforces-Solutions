#include <iostream>
#include <map>
#include <cmath>
using namespace std;

int main()
{
    int t;
    map <int , int> mp;
    int n , m;
    int num;
    int sum;
    cin >> t;
    while(t--)
    {
        sum = 0;
        mp.clear();
        cin >> n >> m;
        for(int i = 0; i < n; i++)
        {
            cin >> num;
            mp[num % m]++;
        }

        for(int i = 1; i <= m / 2; i++)
        {
            if(mp.count(i) && mp.count(m - i))
            sum += max( 1 , abs(mp[i] - mp[m - i]));
            
            else if(mp.count(i))
            sum += mp[i];
            
            else if(mp.count(m - i))
            sum += mp[m - i];
        }
        if(mp.count(0))
        sum++;
       
        cout << sum << endl;

    }   
    
    return 0;
}
