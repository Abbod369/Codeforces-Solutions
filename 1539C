#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int n ;
    long long k , x;
    long long arr[200001];
    int numOfGroubs = 1;

    cin >> n >> k >> x;

    for(int i = 0; i < n; i++)
    cin >> arr[i];

    sort(arr , arr + n);

    
    for(int i = 0; i < n - 1; i++)
    arr[i] = arr[i + 1] - arr[i];
        
    sort(arr , arr + n - 1);

    for(int i = 0; i < n - 1; i++)
    {
        if(arr[i] > x)
        {
            if(k >= (arr[i] - 1) / x)
            k -= ((arr[i] - 1) / x);
        
            else
            numOfGroubs++;
        }

    }

    cout << numOfGroubs << endl;

    return 0;
}
