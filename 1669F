#include <iostream>
using namespace std;

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int t , n;
    int sumOfFront;
    int sumOfBack;
    int FinalSum;
    cin >> t;
    while(t--)
    {
        FinalSum = 0;
        cin >> n;
        int arr[n + 1];

        for(int i = 1; i <= n; i++)
        cin >> arr[i];

        sumOfFront = arr[1];
        sumOfBack = arr[n];

        for(int i = 1 , j = n; i < j;)
        {
            if(sumOfFront == sumOfBack)
            {
                FinalSum = i + (n - (j - 1));
                i++;
                j--;

                sumOfFront += arr[i];
                sumOfBack += arr[j];
            }

            if(sumOfFront > sumOfBack)
            {
                j--;
                sumOfBack += arr[j];
                
            }

            if(sumOfFront < sumOfBack)
            {
                i++;
                sumOfFront += arr[i];
                
            }
        }
        
        cout << FinalSum << endl;        
    }

    return 0;
}
