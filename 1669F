#include <iostream>
using namespace std;

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int t, n;
    int arr[200002];
    int counter1;
    int counter2;
    int sum1;
    int sum2;
    cin >> t;
    while(t--)
    {
        counter1 = 0;
        counter2 = 0;
        sum1 = 0;
        sum2 = 0;
        cin >> n;
        for(int i = 1; i <= n; i++)
            cin >> arr[i];

        for(int i = 1, j = n; i < j;)
        {
            if(sum1 > sum2)
            {
                sum2 += arr[j];
                counter1++;
                j--;
                
                if(j == i)
                {
                    if(sum2 + arr[j] == sum1)
                    {
                        sum2 += arr[j];
                        counter1++;
                    }

                    if(sum2 == sum1 + arr[i])
                    {
                        sum1 += arr[i];
                        counter1++;
                    }
                }
                
                if(sum1 == sum2)
                counter2 = counter1;
            }

            if(sum1 <= sum2)
            {
                sum1 += arr[i];
                counter1++;
                i++;
                if(j == i)
                {
                    if(sum2 + arr[j] == sum1)
                    {
                        sum2 += arr[j];
                        counter1++;
                    }

                    if(sum2 == sum1 + arr[i])
                    {
                        sum1 += arr[i];
                        counter1++;
                    }
                }
                
                if(sum1 == sum2)
                counter2 = counter1;
            }
            
        }

        cout << counter2 << endl;
    }
    return 0;
}
