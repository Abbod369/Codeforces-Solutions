#include <iostream>
using namespace std;
 
int main()
{
    int t , n;
    int arr[2001];
    int dif;
    int maxVal;
    int minVal;
    cin >> t;
    while(t--)
    {
        dif = 0;
        maxVal = 0;
        minVal = 1e9;
        cin >> n;
        for(int i = 0; i < n; i++)
        {
            cin >> arr[i];
            if(arr[i] > maxVal)
            maxVal = arr[i];
 
            if(arr[i] < minVal)
            minVal = arr[i];
        }
 
        if(arr[0] == minVal || arr[n - 1] == maxVal)
        {
            cout << maxVal - minVal << endl;
            continue;
        }
 
        for(int i = 0; i < n; i++)
        dif = max(dif , (arr[i] - arr[0]));
 
        for(int i = 0; i < n; i++)
        dif = max(dif , (arr[n - 1] - arr[i]));
 
        for(int i = 0; i < n - 1; i++)
        dif = max(dif , (arr[i] - arr[i + 1]));
 
        cout << dif << endl;
 
    }
 
    return 0;
}
