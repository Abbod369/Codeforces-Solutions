#include <iostream>
using namespace std;

int main()
{
    int t;
    int l1 , r1;
    int l2 , r2;
    cin >> t;
    while(t--)
    {
        cin >> l1 >> r1;
        cin >> l2 >> r2;

        if(l1 <= r2)
        {
            if(r1 >= l2)
            {
                if(r1 == r2)
                {
                    if(l1 == l2)
                    cout << r1 - l1 << endl;

                    else
                    cout << (r1 - max(l1 , l2)) + 1 << endl; 
                }
                else if(l1 == l2)
                cout << (min(r1 , r2) - l1) + 1 << endl;

                else
                cout << (min(r1 , r2) - max(l1 , l2)) + 2 << endl;
            }

            else
            cout << 1 << endl;
        }

        else
        cout << 1 << endl;

    }

    return 0;
}
