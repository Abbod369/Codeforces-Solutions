#include <iostream>
#include <algorithm>
#include <map>
#include <vector>
using namespace std;

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    int n , k;
    int num;
    map <int , int> mp;
    cin >> t;
    while(t--)
    {
        mp.clear();
        cin >> n >> k;
        for(int i = 0; i < n; i++)
        {
            cin >> num;
            mp[num]++;
        }

        vector <int> vec(mp.size());

        int counter = 0;
        for(auto it : mp)
        {
            vec[counter] = it.second;
            counter++;
        }

        sort(vec.begin() , vec.end());
        
        int distance = vec.size();

        for(int i = 0; i < vec.size(); i++)
        {
            if(k >= vec[i])
            {
                k -= vec[i];
                distance--;
            }
            else
            break;
        }
        
        cout << max(1 , distance) << endl;
    }

    return 0;
}
