#include<iostream>
using namespace std;

int main()
{
    int t;
    int n , s;
    int num;
    int sum;
    cin >> t;
    while(t--)
    {
        sum = 0;
        int arr[3] = {0};

        cin >> n >> s;
        for(int i = 0; i < n; i++)
        {
            cin >> num;
            arr[num]++;

            sum += num;
        }

        int dif = s - sum;

        if(dif == 0)
        cout << -1 << endl;

        else if(dif >= 2)
        cout << -1 << endl;

        else
        {
            while(arr[0] > 0)
            {
                cout << 0 << ' ';
                arr[0]--;
            }
        
            while(arr[2] > 0)
            {
                cout << 2 << ' ';
                arr[2]--;
            }
            
            while(arr[1] > 0)
            {
                cout << 1 << ' ';
                arr[1]--;
            }

            cout << endl;

        }

    }
        
    return 0; 
}
