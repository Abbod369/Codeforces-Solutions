#include <iostream>
#include <algorithm>
#include <iomanip>
using namespace std;

int main()
{
    int n , l;
    double arr[1001];
    double distance = 0;

    cin >> n >> l;
    
    for(int i = 0; i < n; i++)
    cin >> arr[i];

    sort(arr , arr + n);

    if(arr[0] != 0)
    distance = arr[0];


    for(int i = 0; i < n - 1; i++)
    if((arr[i + 1] - arr[i]) / 2 > distance)
    distance = (arr[i + 1] - arr[i]) / 2;

    if(arr[n - 1] != l)
    {
        if(distance < l - arr[n - 1])
        distance = l - arr[n - 1];
    }

    cout << fixed << setprecision(10) << distance << endl;

    return 0;
}
